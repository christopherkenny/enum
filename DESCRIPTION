Package: enum
Title: Enumerate Partitions of Grid Graphs
Version: 0.0.1
Authors@R: c(
    person(given = "Christopher T.",
           family = "Kenny",
           role = c("aut", "cre", "cph"),
           email = "ctkenny@proton.me",
           comment = c(ORCID = "0000-0002-9386-6860")),
    person("Zachary", "Schutzman", role = "cph",
